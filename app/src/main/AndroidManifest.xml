<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The headset is reached over classic Bluetooth, on the serial channel it registers with SDP,
         so there is nothing to scan for and no BLE feature to require. Below Android 12 these two
         are all the radio needs, and both are granted at install. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Android 12 onwards, which is what the Karoo runs now, and what reading the paired devices
         and opening the channel to one needs. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".XmHeadphonesApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XmHeadphones"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Karoo sends a tap on the noise cancelling field as a broadcast. The PendingIntent is
             created here, so the receiver can stay unexported. -->
        <receiver
            android:name=".NoiseCancellingTapReceiver"
            android:exported="false" />

        <service
            android:name=".XmHeadphonesExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <!-- Required for this extension to be discovered by the Karoo System -->
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>
    </application>
</manifest>
