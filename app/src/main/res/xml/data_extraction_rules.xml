<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 onwards reads this instead of res/xml/backup_rules.xml. Same include list, for both
     cloud backup and a device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="sharedpref"
            path="sony-headphones.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="sharedpref"
            path="sony-headphones.xml" />
    </device-transfer>
</data-extraction-rules>
