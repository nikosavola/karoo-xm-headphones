root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Kotlin's own style guide, which the sources follow. Not the Gradle build scripts: those are
# 2-space like the rest of the tree, so they keep the default above.
[*.kt]
indent_size = 4
max_line_length = 120

[*.kts]
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
